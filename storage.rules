rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ====================================================
    // STORAGE ACCESS VALIDATION HELPERS
    // ====================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAccountActive() {
      return isSignedIn() && request.auth.token.accountStatus == 'ACTIVE';
    }

    function isSystemAdmin() {
      return isAccountActive() &&
        (request.auth.token.role == 'System Administrator' || request.auth.token.role == 'SYSTEM_ADMIN');
    }

    function isInternalOperations() {
      return isAccountActive() && (
        isSystemAdmin() ||
        request.auth.token.role == 'Project Manager' ||
        request.auth.token.role == 'Compliance Reviewer' ||
        request.auth.token.role == 'Executive Approver' ||
        request.auth.token.role == 'Auditor'
      );
    }

    function belongsToOrganization(orgId) {
      return isAccountActive() && (
        request.auth.token.organizationId == orgId ||
        isSystemAdmin()
      );
    }

    // MIME type and file size validation
    function isValidDocumentUpload() {
      return request.resource.size <= 50 * 1024 * 1024 && // 50MB max
        request.resource.contentType.matches('application/pdf|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/acad|application/octet-stream|application/zip');
    }

    function isValidImageUpload() {
      return request.resource.size <= 15 * 1024 * 1024 && // 15MB max
        request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    // ====================================================
    // PUBLIC ASSETS (Strictly verified marketing assets)
    // ====================================================
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    match /documents/public/{fileName} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    // ====================================================
    // MULTI-TENANT PRIVATE WORKSPACE PATHS
    // ====================================================
    // /tenants/{tenantId}/organizations/{organizationId}/clients/...
    match /tenants/{tenantId}/organizations/{orgId}/clients/{allPaths=**} {
      allow read: if belongsToOrganization(orgId) || isInternalOperations();
      allow write: if (belongsToOrganization(orgId) || isInternalOperations()) &&
                      (isValidDocumentUpload() || isValidImageUpload());
    }

    // /tenants/{tenantId}/organizations/{organizationId}/suppliers/...
    match /tenants/{tenantId}/organizations/{orgId}/suppliers/{allPaths=**} {
      allow read: if belongsToOrganization(orgId) || isInternalOperations();
      allow write: if (belongsToOrganization(orgId) || isInternalOperations()) &&
                      (isValidDocumentUpload() || isValidImageUpload());
    }

    // /tenants/{tenantId}/organizations/{organizationId}/partners/...
    match /tenants/{tenantId}/organizations/{orgId}/partners/{allPaths=**} {
      allow read: if belongsToOrganization(orgId) || isInternalOperations();
      allow write: if (belongsToOrganization(orgId) || isInternalOperations()) &&
                      (isValidDocumentUpload() || isValidImageUpload());
    }

    // /tenants/{tenantId}/projects/{projectId}/documents/...
    match /tenants/{tenantId}/projects/{projectId}/documents/{allPaths=**} {
      allow read: if isInternalOperations() ||
                     (isAccountActive() && request.auth.token.assignedProjects != null &&
                      (projectId in request.auth.token.assignedProjects || 'all' in request.auth.token.assignedProjects));
      allow write: if isInternalOperations() && isValidDocumentUpload();
    }

    // /tenants/{tenantId}/projects/{projectId}/evidence/...
    match /tenants/{tenantId}/projects/{projectId}/evidence/{allPaths=**} {
      allow read: if isInternalOperations();
      allow write: if isInternalOperations() && (isValidImageUpload() || isValidDocumentUpload());
    }

    // Legacy paths fallback with organization verification
    match /organizations/{orgId}/projects/{projectId}/{allPaths=**} {
      allow read: if belongsToOrganization(orgId) || isInternalOperations();
      allow write: if (belongsToOrganization(orgId) || isInternalOperations()) && isValidDocumentUpload();
    }

    match /partners/{partnerId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == partnerId || isSystemAdmin());
      allow write: if isSignedIn() && (request.auth.uid == partnerId || isSystemAdmin()) && isValidDocumentUpload();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
