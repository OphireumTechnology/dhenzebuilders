rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('SYSTEM_ADMIN') || hasRole('EXECUTIVE');
    }

    function isComplianceReviewer() {
      return hasRole('COMPLIANCE_REVIEWER') || isAdmin();
    }

    function isProjectManager() {
      return hasRole('PROJECT_MANAGER') || isAdmin();
    }

    function isMemberOfOrg(orgId) {
      return isAuthenticated() && (
        getUserData().organizationId == orgId ||
        isAdmin()
      );
    }

    // Public collections (read-only for public, write for admin/editor)
    match /capabilities/{capabilityId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('CONTENT_EDITOR');
    }

    match /industries/{industryId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('CONTENT_EDITOR');
    }

    match /portfolioProjects/{projectId} {
      allow read: if resource.data.clientDisclosureStatus == 'Public' || isAdmin() || isMemberOfOrg(resource.data.ownerOrganizationId);
      allow write: if isAdmin() || isProjectManager();
    }

    match /insights/{articleId} {
      allow read: if resource.data.publicationStatus == 'Published' || isAdmin() || hasRole('CONTENT_EDITOR');
      allow write: if isAdmin() || hasRole('CONTENT_EDITOR');
    }

    // Inquiries: Anyone can submit, only admins and project managers can view and process
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.privacyConsent == true &&
                       request.resource.data.accuracyConfirmed == true;
      allow read, update: if isAdmin() || isProjectManager();
      allow delete: if isAdmin();
    }

    // Consultations & Bookings
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isAuthenticated() && (
        resource.data.clientEmail == request.auth.token.email ||
        isAdmin() ||
        isProjectManager()
      );
      allow update, delete: if isAdmin() || isProjectManager();
    }

    // Partner and Supplier Registrations
    match /supplierProfiles/{profileId} {
      allow create: if true;
      allow read: if isAuthenticated() && (
        request.auth.uid == profileId ||
        isAdmin() ||
        hasRole('FINANCE_STAFF')
      );
      allow update: if isAuthenticated() && (request.auth.uid == profileId || isAdmin());
      allow delete: if isAdmin();
    }

    // Client Projects (Organization isolated)
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
      allow write: if isAdmin() || isProjectManager();
    }

    // Project Documents with version control
    match /projectDocuments/{docId} {
      allow read: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
      allow create: if isAuthenticated() && (
        isMemberOfOrg(request.resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
      // No overwriting old document records; new versions create documentVersions records
      allow update, delete: if isAdmin();
    }

    match /documentVersions/{versionId} {
      allow read: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit versioning
    }

    // RFI, Submittals, Change Requests
    match /rfiRecords/{rfiId} {
      allow read, write: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
    }

    match /submittals/{submittalId} {
      allow read, write: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
    }

    match /changeRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        isProjectManager()
      );
      allow write: if isAdmin() || isProjectManager();
    }

    // Invoices and Payments
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        hasRole('FINANCE_STAFF')
      );
      allow write: if isAdmin() || hasRole('FINANCE_STAFF');
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isMemberOfOrg(resource.data.organizationId) ||
        isAdmin() ||
        hasRole('FINANCE_STAFF')
      );
      allow write: if isAdmin() || hasRole('FINANCE_STAFF');
    }

    // Knowledge Sources for Builder Assistant (RAG)
    match /knowledgeSources/{sourceId} {
      allow read: if resource.data.classification == 'Public' && resource.data.approvalStatus == 'Approved' ||
                     (isAuthenticated() && (
                        (resource.data.classification == 'Client-Private' && isMemberOfOrg(resource.data.ownerOrganizationId)) ||
                        (resource.data.classification == 'Internal' && (isAdmin() || isProjectManager()))
                     ));
      allow write: if isAdmin() || isComplianceReviewer();
    }

    match /assistantConversations/{conversationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /escalationRequests/{escalationId} {
      allow create: if true;
      allow read, write: if isAdmin() || isProjectManager();
    }

    // Security & Audit Logs: strictly append-only or admin read
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }

    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if true; // System-triggered events
    }

    // Commercial Pricing Governance & Price Versions (Maker-Checker Enforced in Rules)
    match /priceVersions/{versionId} {
      allow read: if true;
      allow create: if isAdmin() || hasRole('FINANCE_STAFF');
      // Maker-Checker Separation of Duties: Creator cannot approve their own version!
      allow update: if (isAdmin() || hasRole('EXECUTIVE')) &&
                       request.auth.token.email != resource.data.createdBy;
      allow delete: if isAdmin();
    }

    // Subscriptions & Entitlements (Server authoritative only; users cannot alter status)
    match /userSubscriptions/{subId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        hasRole('FINANCE_STAFF')
      );
      // Users can NEVER alter their own subscription tier or active status
      allow write: if isAdmin();
    }

    // Credit Wallets (Strictly server-authoritative; zero client-side direct writes)
    match /creditWallets/{walletId} {
      allow read: if isAuthenticated() && (
        walletId == request.auth.uid ||
        isAdmin()
      );
      // Direct client Firestore balance modification is strictly forbidden
      allow write: if false;
    }

    // Credit Ledger (Append-only immutable audit trail; direct client writes forbidden)
    match /creditLedger/{ledgerId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        hasRole('FINANCE_STAFF')
      );
      allow create, update, delete: if false;
    }

    // Credit Reservations (Two-phase reservation records; client cannot alter)
    match /creditReservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // Manual Bank Transfers (Maker-Checker separation of duties)
    match /bankTransfers/{transferId} {
      allow read: if isAuthenticated() && (
        resource.data.clientEmail == request.auth.token.email ||
        isAdmin() ||
        hasRole('FINANCE_STAFF')
      );
      allow create: if isAuthenticated();
      // Approver cannot be the same staff member who recorded the payment!
      allow update: if (isAdmin() || hasRole('FINANCE_STAFF')) &&
                       request.auth.token.email != resource.data.recordedBy;
      allow delete: if isAdmin();
    }

    // Users & Roles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
