rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // DEFAULT-DENY SECURITY POLICY
    // ====================================================
    // Any document or collection not explicitly permitted below is strictly DENIED.

    // ====================================================
    // CORE AUTHENTICATION & ATTRIBUTE VALIDATION HELPERS
    // ====================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAccountActive() {
      return isSignedIn() &&
        (request.auth.token.accountStatus == 'ACTIVE' || getUserDoc().accountStatus == 'ACTIVE') &&
        (request.auth.token.locked != true && getUserDoc().locked != true);
    }

    function hasRole(role) {
      return isAccountActive() && (
        request.auth.token.role == role ||
        getUserDoc().role == role
      );
    }

    function isSystemAdmin() {
      return hasRole('System Administrator') || hasRole('SYSTEM_ADMIN');
    }

    function isExecutiveApprover() {
      return hasRole('Executive Approver') || hasRole('EXECUTIVE_APPROVER');
    }

    function isComplianceReviewer() {
      return hasRole('Compliance Reviewer') || hasRole('COMPLIANCE_REVIEWER');
    }

    function isProjectManager() {
      return hasRole('Project Manager') || hasRole('PROJECT_MANAGER');
    }

    function isAuditor() {
      return hasRole('Auditor') || hasRole('AUDITOR');
    }

    function isInternalOperations() {
      return isSystemAdmin() || isExecutiveApprover() || isComplianceReviewer() || isProjectManager() || isAuditor();
    }

    function belongsToOrganization(orgId) {
      return isAccountActive() && (
        request.auth.token.organizationId == orgId ||
        getUserDoc().organizationId == orgId ||
        isSystemAdmin() ||
        isAuditor()
      );
    }

    function isAssignedToProject(projectId) {
      return isAccountActive() && (
        isSystemAdmin() ||
        isAuditor() ||
        isExecutiveApprover() ||
        (getUserDoc().assignedProjects != null &&
         (projectId in getUserDoc().assignedProjects || 'all' in getUserDoc().assignedProjects))
      );
    }

    function canReadClassification(classification) {
      return classification == 'Public' ||
        (isAccountActive() && (
          (classification == 'Internal' && isInternalOperations()) ||
          (classification == 'Confidential' && (isInternalOperations() || hasRole('Active Client'))) ||
          (classification == 'Restricted-Financial' && (isExecutiveApprover() || hasRole('Active Client')))
        ));
    }

    function recordIsNotFrozen() {
      return resource.data.isFrozen != true &&
             resource.data.legalHold != true;
    }

    // ====================================================
    // 1. PUBLIC MARKETING & CORPORATE INFORMATION (READ-ONLY)
    // ====================================================
    match /publicCompanyProfile/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    match /capabilities/{capabilityId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    match /industries/{industryId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    match /verifiedPublicProjects/{projectId} {
      allow read: if resource.data.isPublic == true;
      allow write: if isSystemAdmin() || isProjectManager();
    }

    match /publicInsights/{articleId} {
      allow read: if resource.data.published == true;
      allow write: if isSystemAdmin();
    }

    // Inquiries: Anyone can submit inquiries, but only authorized internal staff can view/process
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.privacyConsent == true &&
                       request.resource.data.accuracyConfirmed == true;
      allow read: if isInternalOperations();
      allow update: if isInternalOperations() && recordIsNotFrozen();
      allow delete: if isSystemAdmin();
    }

    // Bookings & Consultations
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isSignedIn() && (
        resource.data.clientEmail == request.auth.token.email ||
        isInternalOperations()
      );
      allow update, delete: if isInternalOperations();
    }

    // ====================================================
    // 2. USER ACCOUNTS & INVITATIONS
    // ====================================================
    match /users/{userId} {
      // Users can only read their own profile; admins and auditors can read
      allow read: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin() || isAuditor());
      // Users can NEVER alter their own roles, organization, or accountStatus
      allow create: if isSystemAdmin();
      allow update: if isSystemAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'organizationId', 'portalType', 'assignedProjects', 'accountStatus', 'locked', 'mfaEnrolled', 'mfaRequired']));
      allow delete: if false; // Soft-delete or deactivation only
    }

    match /invitations/{invitationId} {
      // Only System Administrators can create or view invitations
      allow read: if isSystemAdmin() || isAuditor();
      allow create: if isSystemAdmin();
      allow update: if isSystemAdmin();
      allow delete: if false;
    }

    // ====================================================
    // 3. TENANT & CLIENT WORKSPACES
    // ====================================================
    match /tenants/{tenantId}/organizations/{orgId} {
      allow read: if belongsToOrganization(orgId);
      allow write: if isSystemAdmin();

      match /clients/{clientId} {
        allow read: if belongsToOrganization(orgId);
        allow write: if isSystemAdmin() || isProjectManager();
      }

      match /suppliers/{supplierId} {
        // Supplier can only read its own organization records
        allow read: if belongsToOrganization(orgId);
        allow write: if isSystemAdmin() || (belongsToOrganization(orgId) && recordIsNotFrozen());
      }

      match /partners/{partnerId} {
        // Partner can only read its own organization records
        allow read: if belongsToOrganization(orgId);
        allow write: if isSystemAdmin() || (belongsToOrganization(orgId) && recordIsNotFrozen());
      }
    }

    // ====================================================
    // 4. MULTI-TENANT PROJECT ISOLATION (ABAC)
    // ====================================================
    match /tenants/{tenantId}/projects/{projectId} {
      allow read: if isAssignedToProject(projectId) &&
                     belongsToOrganization(resource.data.ownerOrganizationId);
      allow create: if isSystemAdmin() || isProjectManager();
      allow update: if (isSystemAdmin() || isProjectManager()) && recordIsNotFrozen();
      allow delete: if false;

      // Project Documents & Controlled Drawing Sets
      match /documents/{docId} {
        allow read: if isAssignedToProject(projectId) &&
                       canReadClassification(resource.data.classification);
        allow create: if (isProjectManager() || isSystemAdmin()) && recordIsNotFrozen();
        // Modification of versioned records forbidden (append new version record instead)
        allow update, delete: if isSystemAdmin() && !recordIsNotFrozen();
      }

      // RFIs, Submittals & Site Work Packages
      match /workPackages/{pkgId} {
        allow read: if isAssignedToProject(projectId);
        allow write: if (isProjectManager() || isSystemAdmin()) && recordIsNotFrozen();
      }

      match /rfis/{rfiId} {
        allow read: if isAssignedToProject(projectId);
        allow create, update: if isAssignedToProject(projectId) && recordIsNotFrozen();
        allow delete: if isSystemAdmin();
      }

      // Sealed Bids & Tenders: Competitors can NEVER see each other's bids
      match /tenders/{tenderId} {
        allow read: if isInternalOperations() ||
                       (isSignedIn() && resource.data.submittedByOrganizationId == getUserDoc().organizationId);
        // Only internal staff or the submitting bidder can create; never update after sealing
        allow create: if isSignedIn() && request.resource.data.submittedByOrganizationId == getUserDoc().organizationId;
        allow update, delete: if false; // Immutable sealed bids
      }
    }

    // Legacy projects fallback mapping
    match /projects/{projectId} {
      allow read: if isAssignedToProject(projectId) &&
                     belongsToOrganization(resource.data.organizationId);
      allow write: if isSystemAdmin() || isProjectManager();
    }

    match /projectDocuments/{docId} {
      allow read: if isAssignedToProject(resource.data.projectId) &&
                     canReadClassification(resource.data.classification);
      allow create: if (isProjectManager() || isSystemAdmin()) && recordIsNotFrozen();
      allow update, delete: if isSystemAdmin();
    }

    // ====================================================
    // 5. INTERNAL OPERATIONS & COMPLIANCE
    // ====================================================
    match /tenants/{tenantId}/operations/{opId} {
      allow read: if isInternalOperations();
      // Separation of Duties: Project Manager cannot remove compliance holds or approve payments
      allow write: if isInternalOperations() &&
        !(isProjectManager() && request.resource.data.complianceHoldStatus != resource.data.complianceHoldStatus);
    }

    // ====================================================
    // 6. IMMUTABLE AUDIT LOGS (Section 18)
    // ====================================================
    match /auditLogs/{logId} {
      // Only System Administrators and Auditors can read audit logs
      allow read: if isSystemAdmin() || isAuditor();
      // Server-side append only
      allow create: if isSignedIn();
      allow update, delete: if false; // Absolute immutability
    }

    match /securityEvents/{eventId} {
      allow read: if isSystemAdmin() || isAuditor();
      allow create: if true;
      allow update, delete: if false;
    }

    // ====================================================
    // 7. COMMERCIAL PRICING & PROPOSALS (PRIVATE TO AUTHENTICATED)
    // ====================================================
    // Public cannot view pricing or price versions (Section 3)
    match /priceVersions/{versionId} {
      allow read: if isAccountActive();
      allow create: if isSystemAdmin() || hasRole('FINANCE_STAFF');
      // Maker-Checker Separation of Duties: Creator cannot approve their own proposed version
      allow update: if (isSystemAdmin() || isExecutiveApprover()) &&
                       request.auth.token.email != resource.data.createdBy;
      allow delete: if isSystemAdmin();
    }

    match /userSubscriptions/{subId} {
      allow read: if isAccountActive() && (
        resource.data.userId == request.auth.uid ||
        isSystemAdmin() ||
        isAuditor()
      );
      allow write: if isSystemAdmin();
    }

    match /creditWallets/{walletId} {
      allow read: if isAccountActive() && (walletId == request.auth.uid || isSystemAdmin());
      allow write: if false; // Strictly server-authoritative
    }

    match /creditLedger/{ledgerId} {
      allow read: if isAccountActive() && (
        resource.data.userId == request.auth.uid ||
        isSystemAdmin() ||
        isAuditor()
      );
      allow create, update, delete: if false; // Immutable ledger
    }

    // Bank Transfers (Maker-Checker enforced)
    match /bankTransfers/{transferId} {
      allow read: if isAccountActive() && (
        resource.data.clientEmail == request.auth.token.email ||
        isSystemAdmin() ||
        isExecutiveApprover() ||
        isAuditor()
      );
      allow create: if isAccountActive();
      allow update: if (isSystemAdmin() || isExecutiveApprover()) &&
                       request.auth.token.email != resource.data.recordedBy;
      allow delete: if isSystemAdmin();
    }

    // Knowledge sources for AI Assistant (RAG)
    match /knowledgeSources/{sourceId} {
      allow read: if resource.data.classification == 'Public' && resource.data.approvalStatus == 'Approved' ||
        (isAccountActive() && (
          (resource.data.classification == 'Client-Private' && belongsToOrganization(resource.data.ownerOrganizationId)) ||
          (resource.data.classification == 'Internal' && isInternalOperations())
        ));
      allow write: if isSystemAdmin() || isComplianceReviewer();
    }

    match /assistantConversations/{conversationId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ====================================================
    // CATCH-ALL DEFAULT REJECTION
    // ====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
